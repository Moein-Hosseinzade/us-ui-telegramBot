# ── Telegram ─────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated admin chat IDs (from @userinfobot). First = primary
# (receives startup notice + daily backups).
ADMIN_CHAT_ID=111111111,222222222

# ── Web dashboard (HTTP basic auth on :8080) ─────────────
WEB_USER=admin
WEB_PASS=change_me

# ── Database paths (host paths, mounted into the container) ─
XUI_DB_PATH=/etc/x-ui/x-ui.db
SUI_DB_PATH=/usr/local/s-ui/db/s-ui.db

# ── x-ui panel API (Bearer token) ────────────────────────
# URL = https://<host-or-ip>:<panelPort>/<webBasePath>
XUI_PANEL_URL=https://127.0.0.1:2053/yourBasePath
XUI_API_TOKEN=your_xui_api_token

# ── s-ui panel API (session login) ───────────────────────
# URL = https://<domain>:<port>/<webPath>
SUI_API_URL=https://your.domain:2096/app
SUI_USER=admin
SUI_PASS=change_me

# ── Subscription link base (sub aggregator) ──────────────
SUB_BASE_URL=https://your.sub.domain:61111

# ── Daily DB backup hour (UTC, 0-23) ─────────────────────
BACKUP_HOUR=3

# ── Misc ─────────────────────────────────────────────────
TZ=UTC
HOST_PROC=/host/proc
HOST_SYS=/host/sys
